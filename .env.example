# 复制本文件为 .env，并填入你自己的 Key。
# 注意：.env 含密钥，请勿提交到代码仓库或打包进作业压缩包。

# --- 必填 ---
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# --- 选填 ---
# 只要服务支持 OpenAI 兼容接口 + function calling 即可，常见选择：
#   DeepSeek:  https://api.deepseek.com/v1                        模型 deepseek-chat
#   通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
#   Moonshot:  https://api.moonshot.cn/v1                         模型 moonshot-v1-8k
#   OpenAI:    https://api.openai.com/v1                          模型 gpt-4o-mini
# 默认给出 DeepSeek（国内可直连）。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 温度（越小越稳定，推荐 0.0 ~ 0.3）
LLM_TEMPERATURE=0.2
# 单次回复最大 token
LLM_MAX_TOKENS=2048
# 失败重试次数
LLM_MAX_RETRIES=3
# 单次请求超时（秒）
LLM_TIMEOUT=60
